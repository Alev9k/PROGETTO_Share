                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </VBox>

                                <VBox onMouseClicked="#handleCreateGroup" prefHeight="160.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-cursor: hand;">
                                    <children>
                                        <Label text="🏗️" font="$x1" />
                                        <Label text="Nuovo Gruppo" textFill="#1e293b">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </Label>
                                        <Label text="Crea una nuova area collaborativa" textFill="#94a3b8" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </VBox>

                                <VBox onMouseClicked="#handleCreateAsset" prefHeight="160.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-cursor: hand;">
                                    <children>
                                        <Label text="📦" font="$x1" />
                                        <Label text="Nuovo Asset" textFill="#1e293b">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </Label>
                                        <Label text="Definisci nuovi beni per il sistema" textFill="#94a3b8" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
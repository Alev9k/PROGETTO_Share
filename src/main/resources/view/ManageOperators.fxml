<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #f4f7fb;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="boundary.javafx.ManageOperatorsGraphicController">
    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #0f172a;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Share System" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets bottom="40.0" left="20.0" top="30.0" /></VBox.margin>
                </Label>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false"
                        onAction="#handleBackToDashboard" prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="Dashboard">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleBackToGroups"
                        prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-cursor: default;"
                        text="Gestione gruppi">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleCreateGroup"
                        prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="Crea gruppo">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <VBox VBox.vgrow="ALWAYS" />
                <Separator opacity="0.1" prefWidth="200.0" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleLogout"
                        prefHeight="50.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-cursor: hand;"
                        text="Logout">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0"
                      style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <children>
                        <Label fx:id="groupNameLabel" text="Gestione membri" textFill="#1e293b">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                    </children>
                    <padding><Insets left="30.0" /></padding>
                </HBox>

                <VBox spacing="10.0">
                    <children>
                        <Label text="Richieste di accesso in attesa" textFill="#64748b">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <TableView fx:id="pendingRequestsTable" prefHeight="190.0"
                                   style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <columns>
                                <TableColumn fx:id="requestOperatorColumn" prefWidth="430.0" text="Operatore" />
                                <TableColumn fx:id="requestDateColumn" prefWidth="280.0" text="Data richiesta" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleRejectRequest" prefHeight="38.0"
                                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"
                                        text="RIFIUTA" />
                                <Button mnemonicParsing="false" onAction="#handleAcceptRequest" prefHeight="38.0"
                                        style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"
                                        text="ACCETTA" />
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets left="30.0" right="30.0" /></padding>
                </VBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Membri del gruppo" textFill="#64748b">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <TableView fx:id="membersTable" prefHeight="190.0" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <columns>
                                <TableColumn fx:id="memberUsernameColumn" prefWidth="430.0" text="Username" />
                                <TableColumn fx:id="memberStatusColumn" prefWidth="280.0" text="Stato" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleToggleBlock" prefHeight="38.0"
                                        style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"
                                        text="BLOCCA / RIATTIVA" />
                            </children>
                        </HBox>
                    </children>
                    <padding><Insets bottom="25.0" left="30.0" right="30.0" /></padding>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #f4f7fb;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="boundary.javafx.MyGroupsGraphicController">
    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #0f172a;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Share System" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets bottom="40.0" left="20.0" top="30.0" /></VBox.margin>
                </Label>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false"
                        onAction="#handleBackToDashboard" prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="Dashboard">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0"
                        prefWidth="240.0"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-cursor: default;"
                        text="I miei gruppi">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleJoinGroup"
                        prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="Unisciti a un gruppo">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleBookings"
                        prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="Le mie prenotazioni">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <VBox VBox.vgrow="ALWAYS" />
                <Separator opacity="0.1" prefWidth="200.0" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleLogout"
                        prefHeight="50.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-cursor: hand;"
                        text="Logout">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0"
                      style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <children>
                        <Label text="Area Operatore &gt; I miei gruppi &gt; Prenota item" textFill="#1e293b">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                    </children>
                    <padding><Insets left="30.0" /></padding>
                </HBox>

                <VBox spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                    <children>
                        <Label text="1. Seleziona un gruppo" textFill="#0f172a">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <ComboBox fx:id="groupChoice" prefHeight="40.0" prefWidth="600.0" />
                    </children>
                    <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                </VBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="2. Seleziona un item disponibile" textFill="#64748b">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <TableView fx:id="itemsTable" prefHeight="225.0"
                                   style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="nameColumn" prefWidth="285.0" text="Item" />
                                <TableColumn fx:id="priorityColumn" prefWidth="110.0" text="Priorità" />
                                <TableColumn fx:id="maxUsageColumn" prefWidth="175.0" text="Durata massima (min)" />
                                <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Stato" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                </VBox>

                <VBox spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                    <children>
                        <Label text="3. Scegli giorno, partenza e durata" textFill="#0f172a">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <ChoiceBox fx:id="dateChoice" prefHeight="40.0" prefWidth="205.0" />
                                <ChoiceBox fx:id="startChoice" prefHeight="40.0" prefWidth="145.0" />
                                <ChoiceBox fx:id="durationChoice" prefHeight="40.0" prefWidth="165.0" />
                                <Button fx:id="bookButton" mnemonicParsing="false" onAction="#handleBook"
                                        prefHeight="40.0" prefWidth="170.0"
                                        style="-fx-background-color: #38bdf8; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"
                                        text="PRENOTA" />
                            </children>
                        </HBox>
                        <Label fx:id="availabilityLabel" text="Seleziona un item per visualizzare gli slot."
                               textFill="#64748b" />
                    </children>
                    <padding><Insets bottom="20.0" left="22.0" right="22.0" top="18.0" /></padding>
                    <VBox.margin><Insets bottom="25.0" left="30.0" right="30.0" /></VBox.margin>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>

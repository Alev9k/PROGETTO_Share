<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="489.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="boundary.javafx.RegistrationGraphicController">
    <children>
        <VBox alignment="CENTER" prefHeight="100.0" style="-fx-background-color: #0f172a;">
            <children>
                <Label text="Share System" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label text="Crea Account" textFill="#94a3b8" />
            </children>
        </VBox>

        <VBox spacing="8.0">
            <children>
                <Label text="Username" />
                <TextField fx:id="usernameField" prefHeight="35.0" />

                <Label text="Password">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>
                <PasswordField fx:id="passwordField" prefHeight="35.0" />

                <Label text="Ruolo">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>
                <ChoiceBox fx:id="roleChoiceBox" prefHeight="35.0" prefWidth="350.0" />
            </children>
            <padding>
                <Insets left="30.0" right="30.0" top="20.0" />
            </padding>
        </VBox>

        <Button onAction="#handleRegistration" prefHeight="45.0" prefWidth="290.0" style="-fx-background-color: #38bdf8; -fx-text-fill: white; -fx-font-weight: bold;" text="REGISTRATI" />

        <Hyperlink onAction="#backToLogin" text="Torna al Login" />
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #f4f7fb;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="boundary.javafx.AdminDashboardGraphicController">

    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #0f172a;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Share System" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="40.0" left="20.0" top="30.0" />
                    </VBox.margin>
                </Label>

                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-cursor: default;" text="Dashboard">
                    <padding>
                        <Insets left="25.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleManageGroups" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;" text="Gestione gruppi">
                    <padding>
                        <Insets left="25.0" />
                    </padding>
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleCreateGroup" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;" text="Crea gruppo">
                    <padding>
                        <Insets left="25.0" />
                    </padding>
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <VBox VBox.vgrow="ALWAYS" /> <Separator opacity="0.1" prefWidth="200.0" />

                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleLogout" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-cursor: hand;" text="Logout">
                    <padding>
                        <Insets left="25.0" />
                    </padding>
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="30.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="welcomeLabel" text="Bentornato, Amministratore" textFill="#1e293b">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Label fx:id="pendingRequestsLabel" text="Nessuna richiesta di accesso in attesa."
                                       textFill="#64748b" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets left="30.0" />
                    </padding>
                </HBox>

                <VBox spacing="20.0">
                    <children>
                        <Label text="Azioni rapide" textFill="#64748b">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <HBox spacing="20.0">
                            <children>
                                <VBox onMouseClicked="#handleManageGroups" prefHeight="170.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-cursor: hand;">
                                    <children>
                                        <Label text="GRUPPI" textFill="#0ea5e9">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <Label text="Gestisci Gruppi" textFill="#1e293b">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                            <VBox.margin>
                                                <Insets top="18.0" />
                                            </VBox.margin>
                                        </Label>
                                        <Label text="Visualizza e modifica i gruppi attivi" textFill="#94a3b8" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </VBox>

                                <VBox onMouseClicked="#handleCreateGroup" prefHeight="170.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-cursor: hand;">
                                    <children>
                                        <Label text="CREAZIONE" textFill="#0ea5e9">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <Label text="Nuovo Gruppo" textFill="#1e293b">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                            <VBox.margin>
                                                <Insets top="18.0" />
                                            </VBox.margin>
                                        </Label>
                                        <Label text="Crea una nuova area collaborativa" textFill="#94a3b8" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </VBox>

                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #f4f7fb;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="boundary.javafx.MyBookingsGraphicController">
    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #0f172a;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Share System" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets bottom="40.0" left="20.0" top="30.0" /></VBox.margin>
                </Label>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false"
                        onAction="#handleBackToDashboard" prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="Dashboard">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleMyGroups"
                        prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="I miei gruppi">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleJoinGroup"
                        prefHeight="45.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;"
                        text="Unisciti a un gruppo">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font size="14.0" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0"
                        prefWidth="240.0"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-cursor: default;"
                        text="Le mie prenotazioni">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <VBox VBox.vgrow="ALWAYS" />
                <Separator opacity="0.1" prefWidth="200.0" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleLogout"
                        prefHeight="50.0" prefWidth="240.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-cursor: hand;"
                        text="Logout">
                    <padding><Insets left="25.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="24.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0"
                      style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <children>
                        <Label text="Area Operatore &gt; Le mie prenotazioni" textFill="#1e293b">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                    </children>
                    <padding><Insets left="30.0" /></padding>
                </HBox>

                <VBox spacing="10.0">
                    <children>
                        <Label text="Prenotazioni registrate" textFill="#0f172a">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="Puoi eliminare una prenotazione prima dell'inizio o riconsegnare l'item durante il suo utilizzo."
                               textFill="#64748b" />
                    </children>
                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                </VBox>

                <TableView fx:id="bookingsTable" prefHeight="430.0"
                           style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="groupColumn" prefWidth="150.0" text="Gruppo" />
                        <TableColumn fx:id="itemColumn" prefWidth="160.0" text="Item" />
                        <TableColumn fx:id="dateColumn" prefWidth="105.0" text="Data" />
                        <TableColumn fx:id="timeColumn" prefWidth="125.0" text="Orario" />
                        <TableColumn fx:id="durationColumn" prefWidth="120.0" text="Durata" />
                        <TableColumn fx:id="deletableColumn" prefWidth="105.0" text="Eliminabile" />
                        <TableColumn fx:id="returnColumn" prefWidth="135.0" text="Riconsegna" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="18.0">
                    <children>
                        <Label fx:id="selectionLabel"
                               text="Seleziona una prenotazione da gestire."
                               textFill="#64748b" HBox.hgrow="ALWAYS" />
                        <Button fx:id="returnButton" disable="true" mnemonicParsing="false"
                                onAction="#handleReturn" prefHeight="42.0" prefWidth="190.0"
                                style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"
                                text="RICONSEGNA ITEM" />
                        <Button fx:id="deleteButton" disable="true" mnemonicParsing="false"
                                onAction="#handleDelete" prefHeight="42.0" prefWidth="220.0"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"
                                text="ELIMINA PRENOTAZIONE" />
                    </children>
                    <VBox.margin><Insets bottom="28.0" left="30.0" right="30.0" /></VBox.margin>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
